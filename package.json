{
  "name": "@mainframework/api-request-worker",
  "version": "1.0.4",
  "description": "Offloads API requests and application state to a Web Worker to keep the UI thread fast.",
  "type": "module",
  "main": "./dist/shared/output/vanilla.js",
  "exports": {
    ".": {
      "types": "./dist/shared/output/vanilla.d.ts",
      "import": "./dist/shared/output/vanilla.js",
      "default": "./dist/shared/output/vanilla.js"
    },
    "./react": {
      "types": "./dist/shared/output/react.d.ts",
      "import": "./dist/shared/output/react.js",
      "default": "./dist/shared/output/react.js"
    }
  },
  "types": "./dist/shared/output/vanilla.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TerrySlack/mainframework-apiworker.git"
  },
  "bugs": {
    "url": "https://github.com/TerrySlack/mainframework-apiworker/issues"
  },
  "homepage": "https://github.com/TerrySlack/mainframework-apiworker",
  "scripts": {
    "husky": "husky",
    "prepare": "husky",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "lint-staged": "lint-staged",
    "prebuild": "yarn husky && yarn clean",
    "build": "rollup -c",
    "tscheck": "tsc"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=0 --no-warn-ignored"
    ],
    "*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "react",
    "typescript",
    "webworker",
    "store"
  ],
  "author": "Terry Slack",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "8",
    "@babel/plugin-syntax-typescript": "8",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "^0.28.1",
    "eslint": "10.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-esbuild": "^6.2.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  }
}
